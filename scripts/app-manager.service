[Unit]
Description=App Management Platform
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/app-manager
Restart=always
RestartSec=5
LimitNOFILE=65535

Environment=APP_MANAGER_CONFIG=/etc/app-manager/config.yaml
Environment=APP_MANAGER_ADDR=:8080

WorkingDirectory=/etc/app-manager

[Install]
WantedBy=multi-user.target
